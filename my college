.btn {
  display: inline-flex;
  padding: 12px 18px;
  border-radius: 999px;
  font-weight: 750;
}

.btn-primary {
  background: var(--primary);
  color: white;
}
.btn:hover {
  transform: translateY(-2px);
}

.btn {
  transition: transform 0.2s ease;
}
.hero::before {
  content: "";
  position: absolute;
  width: 360px;
  height: 360px;
  border-radius: 50%;
}
@media (max-width: 940px) {
  .hero-grid {
    grid-template-columns: 1fr;
